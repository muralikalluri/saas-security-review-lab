# Local-only demo credentials for docker-compose. These are NOT real secrets,
# do not match any real key format, and must never be used outside this lab.
# Copy to .env before running `docker compose up`.

POSTGRES_DB=ledgerlite
POSTGRES_USER=ledgerlite_dev
POSTGRES_PASSWORD=localdev_only_do_not_use

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=localdev_only_do_not_use

# Host-side port mappings only (81xx range, to avoid clashing with other repos
# on this machine). Container-internal ports stay standard (5432, 8080).
API_HOST_PORT=8183
KEYCLOAK_HOST_PORT=8181
POSTGRES_HOST_PORT=8182

# Target A, fixed mode (M3) - a separate module/jar/DB/realm from the
# baseline above, never the same one. See docker-compose.yml's api-fixed
# and postgres-fixed services.
API_FIXED_HOST_PORT=8184
POSTGRES_FIXED_HOST_PORT=8186
# Password for the app-fixed's own restricted, RLS-bound runtime DB role
# (ledgerlite_app) - created by V3__row_level_security.sql with this
# exact value via a Flyway placeholder. One source of truth, read from
# env, never hardcoded in a committed application file.
APP_DB_PASSWORD=apponly_local_dev_password_do_not_use

# Read by isolation-tester (see isolation-tester/config/*.yaml) to override
# base_url without editing a config file - not consumed by docker-compose.
# Point at API_FIXED_HOST_PORT (with --expect expectations/tenant-api.fixed.yaml)
# to run the SAME config against fixed mode instead of baseline.
API_BASE=http://localhost:8183

# Target B (M4/M6) - vibe-app / StudioBook. Runs via `next dev` + a local
# Supabase stack (`supabase start`, own docker-compose managed by the
# Supabase CLI, not this repo's root docker-compose.yml). Host ports here
# are set in targets/vibe-app/supabase/config.toml, listed here per
# CLAUDE.md ("define ports in .env.example, never hardcode") - copy
# targets/vibe-app/.env.example to targets/vibe-app/.env (see that
# module's own README for why its .env is committed, unlike this one).
VIBE_APP_HOST_PORT=8187
SUPABASE_API_HOST_PORT=8188
SUPABASE_DB_HOST_PORT=8189
SUPABASE_DB_SHADOW_HOST_PORT=8192
SUPABASE_STUDIO_HOST_PORT=8190
SUPABASE_INBUCKET_HOST_PORT=8191

# Target B, fixed mode (M6) - targets/vibe-app-fixed/, its own local
# Supabase project (own project_id in supabase/config.toml, so it never
# shares a Postgres/Kong instance with the baseline above) and its own
# ports, so baseline and fixed can run side by side for a before/after
# comparison, same convention as Target A's fixed mode.
VIBE_APP_FIXED_HOST_PORT=8193
SUPABASE_FIXED_API_HOST_PORT=8194
SUPABASE_FIXED_DB_HOST_PORT=8195
SUPABASE_FIXED_DB_SHADOW_HOST_PORT=8196
SUPABASE_FIXED_STUDIO_HOST_PORT=8197
SUPABASE_FIXED_INBUCKET_HOST_PORT=8198
