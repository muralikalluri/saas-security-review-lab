# Local-only demo credentials for docker-compose. These are NOT real secrets,
# do not match any real key format, and must never be used outside this lab.
# Copy to .env before running `docker compose up`.

POSTGRES_DB=ledgerlite
POSTGRES_USER=ledgerlite_dev
POSTGRES_PASSWORD=localdev_only_do_not_use

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=localdev_only_do_not_use

# Host-side port mappings only (81xx range, to avoid clashing with other repos
# on this machine). Container-internal ports stay standard (5432, 8080).
API_HOST_PORT=8183
KEYCLOAK_HOST_PORT=8181
POSTGRES_HOST_PORT=8182
