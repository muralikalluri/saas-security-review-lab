# Deliberately insecure for demonstration. Do not deploy. Run locally only.
#
# B-02 (seeded flaw, SPEC.md B-02): this .env file is committed to the
# repo at all - a real project's .gitignore would exclude it. See this
# module's .gitignore (deliberately does NOT list .env, with a comment
# explaining why) and the repo root .gitignore (anchored to `/.env`, so
# this nested file is untouched by it either).
#
# Every value below is either a well-known, non-secret local Supabase CLI
# demo credential (the same for every `supabase init` on any machine -
# see https://supabase.com/docs/guides/local-development/cli/config,
# these are printed by `supabase start` itself) or an obviously-fake
# placeholder shaped so it cannot match a real provider's key format
# (CLAUDE.md) and therefore cannot trip GitHub push protection.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8188
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# B-01 (seeded flaw, SPEC.md B-01): the SAME service-role key as above,
