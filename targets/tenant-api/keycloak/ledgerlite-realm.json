      "attributes": { "tenant_id": ["tenant-acme-001"], "company_name": ["Acme Fictional Co"] },
      "credentials": [{ "type": "password", "value": "LabPassword-Only-1", "temporary": false }],
      "realmRoles": ["accountant"]
    },
    {
