{
  "realm": "ledgerlite",
  "enabled": true,
  "accessTokenLifespan": 43200,
  "ssoSessionMaxLifespan": 86400,
  "ssoSessionIdleTimeout": 86400,
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 100,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "owner", "description": "Company owner - full access" },
      { "name": "admin", "description": "Company admin" },
      { "name": "accountant", "description": "Accounting staff" },
      { "name": "viewer", "description": "Read-only access" }
    ]
  },
  "clients": [
    {
      "clientId": "tenant-api",
      "enabled": true,
      "publicClient": true,
      "protocol": "openid-connect",
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "tenant_id",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "tenant_id",
            "jsonType.label": "String"
          }
        },
        {
          "name": "company_name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "userinfo.token.claim": "true",
            "user.attribute": "company_name",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "company_name",
            "jsonType.label": "String"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice.owner",
      "enabled": true,
      "email": "alice@acme-fictional.example",
      "firstName": "Alice",
      "lastName": "Owner",
      "attributes": { "tenant_id": ["tenant-acme-001"], "company_name": ["Acme Fictional Co"] },
      "credentials": [{ "type": "password", "value": "LabPassword-Only-1", "temporary": false }],
      "realmRoles": ["owner"]
    },
    {
      "username": "bob.admin",
