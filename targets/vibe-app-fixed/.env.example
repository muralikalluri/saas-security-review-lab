# B-02 (fixed, SPEC.md B-02): copy this to .env and fill in real values -
# unlike the baseline, .env itself is gitignored and never committed here.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:8194
NEXT_PUBLIC_SUPABASE_ANON_KEY=<from `supabase start` output, ANON_KEY>
# B-01 (fixed, SPEC.md B-01): server-only, deliberately never NEXT_PUBLIC_ -
# see components/AdminUserList.tsx / app/api/admin/users/route.ts.
SUPABASE_SERVICE_ROLE_KEY=<from `supabase start` output, SERVICE_ROLE_KEY>

STRIPE_SECRET_KEY=<your Stripe test secret key>
STRIPE_WEBHOOK_SECRET=<your Stripe CLI webhook signing secret>
